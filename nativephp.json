{
    "name": "firstlightui/firstlight-ui",
    "version": "0.1.0-alpha.1",
    "description": "Native controls for NativePHP, shaped for each platform.",
    "namespace": "Firstlight",
    "platforms": [
        "android",
        "ios"
    ],
    "components": [
        {
            "type": "firstlight.segmented",
            "element": "FirstlightUI\\Elements\\Segmented",
