{
    "name": "firstlightui/nativephp",
    "description": "Native controls for NativePHP, shaped for each platform.",
    "type": "nativephp-ui-plugin",
    "license": "MIT",
    "homepage": "https://firstlightui.dev",
    "keywords": [
        "android",
        "ios",
        "nativephp",
        "ui"
    ],
    "authors": [
        {
            "name": "Firstlight UI",
            "email": "team@firstlightui.dev"
        }
    ],
    "support": {
        "email": "team@firstlightui.dev",
        "issues": "https://github.com/firstlightui/nativephp/issues",
        "source": "https://github.com/firstlightui/nativephp"
    },
    "require": {
        "php": "^8.4",
        "illuminate/translation": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/validation": "^10.0|^11.0|^12.0|^13.0",
        "nativephp/mobile": "^4.2",
        "nativephp/mobile-ui": "^0.4",
        "ramsey/uuid": "^4.7"
    },
    "autoload": {
        "psr-4": {
            "FirstlightUI\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "FirstlightUI\\FirstlightServiceProvider"
            ]
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    },
    "require-dev": {
        "illuminate/view": "^13.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-evals": "^5.0"
    },
    "scripts": {
        "test": "pest",
        "docs:build": "bin/build-docs-artifacts",
        "docs:check": "bin/check-docs --development"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
