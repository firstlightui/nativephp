{
    "name": "firstlightui/firstlight-ui",
    "description": "Native controls for NativePHP, shaped for each platform.",
    "type": "nativephp-ui-plugin",
    "license": "MIT",
    "homepage": "https://firstlightui.dev",
    "keywords": [
        "android",
        "ios",
        "nativephp",
        "ui"
    ],
    "authors": [
        {
            "name": "Firstlight UI",
            "email": "team@firstlightui.dev"
        }
    ],
    "support": {
        "email": "team@firstlightui.dev",
        "issues": "https://github.com/firstlightui/firstlight-ui/issues",
        "source": "https://github.com/firstlightui/firstlight-ui"
    },
    "require": {
        "php": "^8.4",
        "nativephp/mobile": "^4.0",
        "nativephp/mobile-ui": "^0.3"
    },
    "autoload": {
        "psr-4": {
            "FirstlightUI\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "FirstlightUI\\FirstlightServiceProvider"
            ]
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    },
    "require-dev": {
        "illuminate/view": "^13.0",
        "pestphp/pest": "^5.0"
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
