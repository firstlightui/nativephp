#!/usr/bin/env php
<?php

declare(strict_types=1);

$arguments = array_slice($argv, 1);
$development = in_array('--development', $arguments, true);
$names = array_values(array_filter($arguments, fn (string $argument): bool => $argument !== '--development'));

if (count($names) !== 1 || preg_match('/^[A-Z][A-Za-z0-9]*$/', $names[0]) !== 1) {
    fwrite(STDERR, "Usage: bin/check-component StudlyCaseName [--development]\n");
    exit(2);
}

$name = $names[0];
$root = dirname(__DIR__);
$publicName = str_ends_with($name, 'Control')
    ? substr($name, 0, -strlen('Control'))
    : $name;
$slug = strtolower((string) preg_replace('/(?<!^)[A-Z]/', '-$0', $publicName));
$controlName = str_ends_with($name, 'Control') ? $name : $name.'Control';
$rendererName = $publicName.'Renderer';
$errors = [];

$manifestPath = $root.'/nativephp.json';
$manifest = is_file($manifestPath) ? json_decode((string) file_get_contents($manifestPath), true) : null;
$component = null;

if (! is_array($manifest)) {
    $errors[] = 'Missing or invalid manifest: nativephp.json';
} else {
    foreach ($manifest['components'] ?? [] as $candidate) {
        if (($candidate['element'] ?? null) === "FirstlightUI\\Elements\\{$name}") {
            $component = $candidate;
            break;
        }
    }

    if (! is_array($component)) {
        $errors[] = "Manifest does not register FirstlightUI\\Elements\\{$name}";
    }
}

$adapter = is_array($component['adapter'] ?? null) ? $component['adapter'] : null;

$required = [
    'Constitution.md',
    "src/Components/{$name}.php",
    "src/Elements/{$name}.php",
    "tests/Feature/{$name}ElementTest.php",
];

if ($adapter === null) {
    array_push(
        $required,
        "resources/ios/{$controlName}.swift",
        "resources/ios/{$rendererName}.swift",
        "resources/android/{$controlName}.kt",
        "resources/android/{$rendererName}.kt",
    );
}

foreach ($required as $path) {
    if (! is_file($root.'/'.$path)) {
        $errors[] = "Missing required path: {$path}";
    }
}

$iosTests = [];
$androidTests = [];

if ($adapter === null) {
    $iosTests = glob($root."/tests/ios/{$name}*Test*.swift") ?: [];
    if ($iosTests === []) {
        $errors[] = "Missing iOS tests matching: tests/ios/{$name}*Test*.swift";
    }

    $androidTestPattern = "tests/android/src/test/kotlin/dev/firstlightui/plugins/firstlight_ui/ui/{$name}*Test*.kt";
    $androidTests = glob($root.'/'.$androidTestPattern) ?: [];
    if ($androidTests === []) {
        $errors[] = "Missing Android tests matching: {$androidTestPattern}";
    }
}

if (is_array($component)) {
    $expected = [
        'blade' => "FirstlightUI\\Components\\{$name}",
    ];

    if ($adapter === null) {
        $expected['ios_renderer'] = $rendererName;
        $expected['android_renderer'] = "dev.firstlightui.plugins.firstlight_ui.ui.{$rendererName}";
    } else {
        $package = $adapter['package'] ?? null;
        $type = $adapter['type'] ?? null;

        if (! is_string($package) || preg_match('~^[a-z0-9_.-]+/[a-z0-9_.-]+$~', $package) !== 1) {
            $errors[] = 'Manifest adapter package must be a Composer package name';
        } elseif (! is_string($type) || trim($type) === '') {
            $errors[] = 'Manifest adapter type must be a non-empty string';
        } else {
            $officialManifestPath = $root.'/vendor/'.$package.'/nativephp.json';
            $officialManifest = is_file($officialManifestPath)
                ? json_decode((string) file_get_contents($officialManifestPath), true)
                : null;
            $officialComponent = null;

            if (! is_array($officialManifest)) {
                $errors[] = "Missing or invalid adapter manifest: vendor/{$package}/nativephp.json";
            } else {
                foreach ($officialManifest['components'] ?? [] as $candidate) {
                    if (($candidate['type'] ?? null) === $type) {
                        $officialComponent = $candidate;
                        break;
                    }
                }
            }

            if (is_array($officialManifest) && ! is_array($officialComponent)) {
                $errors[] = "Adapter package {$package} does not register component type {$type}";
            } elseif (is_array($officialComponent)) {
                foreach (['ios_renderer', 'android_renderer'] as $key) {
                    $value = $officialComponent[$key] ?? null;
                    if (! is_string($value) || $value === '') {
                        $errors[] = "Adapter package {$package} component {$type} has no {$key}";
                    } elseif (($component[$key] ?? null) !== $value) {
                        $errors[] = "Manifest {$key} must match {$package} {$type}: {$value}";
                    }
                }
            }
        }
    }

    foreach ($expected as $key => $value) {
        if (($component[$key] ?? null) !== $value) {
            $errors[] = "Manifest {$key} must be {$value}";
        }
    }
}

$componentFiles = array_values(array_filter(array_merge(
    array_map(fn (string $path): string => $root.'/'.$path, $required),
    $iosTests,
    $androidTests,
    glob($root."/docs/components/{$slug}.md") ?: [],
), 'is_file'));

foreach ($componentFiles as $path) {
    $contents = (string) file_get_contents($path);
    $relativePath = substr($path, strlen($root) + 1);

    if (str_contains($contents, 'FIRSTLIGHT_NOT_IMPLEMENTED')) {
        $errors[] = "Implementation marker remains: {$relativePath}";
    }

    if (str_starts_with($relativePath, 'src/') || str_starts_with($relativePath, 'resources/')) {
        if (preg_match('/\bWebView\b|nativephp_call/', $contents) === 1) {
            $errors[] = "Prohibited web bridge in component source: {$relativePath}";
        }
    }
}

if (! $development) {
    $releasePaths = [
        "docs/components/{$slug}.md",
        "docs/screenshots/{$slug}/ios-light.png",
        "docs/screenshots/{$slug}/ios-dark.png",
        "docs/screenshots/{$slug}/android-light.png",
        "docs/screenshots/{$slug}/android-dark.png",
        "spec/reviews/{$slug}-alpha.md",
    ];

    foreach ($releasePaths as $path) {
        if (! is_file($root.'/'.$path)) {
            $errors[] = "Missing release evidence: {$path}";
        }
    }

    $reviewPath = $root."/spec/reviews/{$slug}-alpha.md";
    if (is_file($reviewPath) && str_contains((string) file_get_contents($reviewPath), '- [ ]')) {
        $errors[] = "Release checklist is incomplete: spec/reviews/{$slug}-alpha.md";
    }
}

$documentationCommand = [$root.'/bin/check-docs', '--component='.$name];
if ($development) {
    $documentationCommand[] = '--development';
}

$documentationProcess = proc_open(
    $documentationCommand,
    [
        0 => ['pipe', 'r'],
        1 => ['pipe', 'w'],
        2 => ['pipe', 'w'],
    ],
    $documentationPipes,
    $root,
);

if (! is_resource($documentationProcess)) {
    $errors[] = 'Unable to run documentation gate: bin/check-docs';
} else {
    fclose($documentationPipes[0]);
    $documentationOutput = stream_get_contents($documentationPipes[1]);
    $documentationError = stream_get_contents($documentationPipes[2]);
    fclose($documentationPipes[1]);
    fclose($documentationPipes[2]);

    if (proc_close($documentationProcess) !== 0) {
        $errors[] = 'Documentation gate failed: bin/check-docs --component='.$name.($development ? ' --development' : '');

        foreach (preg_split('/\R/', trim($documentationOutput."\n".$documentationError)) ?: [] as $line) {
            $line = trim($line);
            if ($line === '' || $line === 'Documentation checks failed:') {
                continue;
            }

            $errors[] = 'Documentation: '.preg_replace('/^-\s*/', '', $line);
        }
    }
}

if ($errors !== []) {
    fwrite(STDERR, "Constitution checks failed for {$name}:\n");
    foreach (array_values(array_unique($errors)) as $error) {
        fwrite(STDERR, "- {$error}\n");
    }
    exit(1);
}

fwrite(STDOUT, "Constitution checks passed for {$name}.\n");
