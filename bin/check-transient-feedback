#!/usr/bin/env php
<?php

declare(strict_types=1);

use FirstlightUI\Documentation\DocumentationArtifactBuilder;
use FirstlightUI\Documentation\DocumentationRepository;
use FirstlightUI\Elements\FeedbackCenter as FeedbackCenterElement;
use FirstlightUI\Elements\FeedbackItem;
use FirstlightUI\Events\FeedbackActionPressed;
use FirstlightUI\Events\FeedbackDismissed;
use FirstlightUI\Facades\Feedback;
use FirstlightUI\Feedback\FeedbackDismissReason;
use FirstlightUI\Feedback\FeedbackManager;
use FirstlightUI\Feedback\FeedbackRecord;
use FirstlightUI\Feedback\FeedbackStore;
use FirstlightUI\Feedback\FeedbackTone;
use FirstlightUI\Feedback\PendingFeedback;
use FirstlightUI\NativeComponents\FeedbackCenter as FeedbackCenterComponent;
use Illuminate\Container\Container;
use Illuminate\Contracts\Events\Dispatcher as DispatcherContract;
use Illuminate\Events\Dispatcher;
use Illuminate\Support\Facades\Facade;
use Native\Mobile\Edge\CallbackRegistry;
use Symfony\Component\Process\Process;

$arguments = array_slice($argv, 1);
$development = false;
$root = dirname(__DIR__);
$showcase = dirname($root).'/firstlight-showcase';
$showcaseWasSpecified = false;

foreach ($arguments as $argument) {
    if ($argument === '--development' && ! $development) {
        $development = true;

        continue;
    }

    if (str_starts_with($argument, '--showcase=') && ! $showcaseWasSpecified) {
        $showcase = substr($argument, strlen('--showcase='));
        $showcaseWasSpecified = true;
        if ($showcase !== '') {
            continue;
        }
    }

    fwrite(STDERR, "Usage: bin/check-transient-feedback [--development] [--showcase=PATH]\n");
    exit(2);
}

$errors = [];
$gaps = [];
$evidenceIssue = static function (string $message) use ($development, &$errors, &$gaps): void {
    if ($development) {
        $gaps[] = $message;
    } else {
        $errors[] = $message;
    }
};

$required = [
    'src/Facades/Feedback.php',
    'src/Feedback/PendingFeedback.php',
    'src/Feedback/FeedbackManager.php',
    'src/Feedback/FeedbackStore.php',
    'src/Feedback/FeedbackRecord.php',
    'src/Feedback/FeedbackTone.php',
    'src/Feedback/FeedbackDismissReason.php',
    'src/Events/FeedbackActionPressed.php',
    'src/Events/FeedbackDismissed.php',
    'src/Elements/FeedbackCenter.php',
    'src/Elements/FeedbackItem.php',
    'src/NativeComponents/FeedbackCenter.php',
    'src/FirstlightServiceProvider.php',
    'resources/views/native/feedback-center.blade.php',
    'resources/ios/FeedbackCenterState.swift',
    'resources/ios/FeedbackCenterControl.swift',
    'resources/ios/FeedbackCenterHost.swift',
    'resources/ios/FirstlightUIInit.swift',
    'resources/android/FeedbackCenterState.kt',
    'resources/android/FeedbackCenterControl.kt',
    'resources/android/FeedbackCenterHost.kt',
    'resources/android/FirstlightUIInit.kt',
    'tests/Feature/TransientFeedbackApiTest.php',
    'tests/Feature/FeedbackCenterTest.php',
    'tests/ios/FeedbackCenterTests.swift',
    'tests/ios/FeedbackCenterSnapshotTests.swift',
    'tests/android/src/test/kotlin/dev/firstlightui/plugins/firstlight_ui/ui/FeedbackCenterTest.kt',
    'docs/components/transient-feedback.md',
    'spec/components/transient-feedback.md',
    'tests/Feature/TransientFeedbackDocumentationTest.php',
];

foreach ($required as $path) {
    if (! is_file($root.'/'.$path)) {
        $errors[] = "Missing required path: {$path}";
    }
}

$read = static function (string $path) use ($root, &$errors): string {
    if (! is_file($root.'/'.$path)) {
        return '';
    }

    $contents = file_get_contents($root.'/'.$path);
    if ($contents === false) {
        $errors[] = "Unable to read required path: {$path}";

        return '';
    }

    return $contents;
};

$requireMarkers = static function (string $path, array $markers) use ($read, &$errors): void {
    $contents = $read($path);
    foreach ($markers as $marker) {
        if (! str_contains($contents, $marker)) {
            $errors[] = "Missing contract marker in {$path}: {$marker}";
        }
    }
};

$json = static function (string $path) use ($root, &$errors): ?array {
    if (! is_file($root.'/'.$path)) {
        $errors[] = "Missing JSON contract: {$path}";

        return null;
    }

    try {
        $decoded = json_decode(
            (string) file_get_contents($root.'/'.$path),
            true,
            flags: JSON_THROW_ON_ERROR,
        );
    } catch (Throwable $exception) {
        $errors[] = "Invalid JSON contract {$path}: {$exception->getMessage()}";

        return null;
    }

    if (! is_array($decoded)) {
        $errors[] = "JSON contract must be an object: {$path}";

        return null;
    }

    return $decoded;
};

if (is_file($root.'/vendor/autoload.php')) {
    require_once $root.'/vendor/autoload.php';
} else {
    $errors[] = 'Missing Composer autoloader: vendor/autoload.php';
}

if (! function_exists('app')) {
    function app(?string $abstract = null): mixed
    {
        $container = Container::getInstance();

        return $abstract === null ? $container : $container->make($abstract);
    }
}

if (! function_exists('event')) {
    function event(object $event): mixed
    {
        return app('events')->dispatch($event);
    }
}

$methodContract = static function (
    string $class,
    string $method,
    array $parameterTypes,
    string $returnType,
) use (&$errors): void {
    if (! class_exists($class) || ! method_exists($class, $method)) {
        $errors[] = "Missing public method: {$class}::{$method}";

        return;
    }

    $reflection = new ReflectionMethod($class, $method);
    $actualParameters = array_map(
        static fn (ReflectionParameter $parameter): string => (string) $parameter->getType(),
        $reflection->getParameters(),
    );

    if (! $reflection->isPublic() || $actualParameters !== $parameterTypes || (string) $reflection->getReturnType() !== $returnType) {
        $errors[] = "Unexpected method contract: {$class}::{$method}";
    }
};

foreach ([
    [FeedbackManager::class, 'message', ['string'], PendingFeedback::class],
    [FeedbackManager::class, 'success', ['string'], PendingFeedback::class],
    [FeedbackManager::class, 'warning', ['string'], PendingFeedback::class],
    [FeedbackManager::class, 'danger', ['string'], PendingFeedback::class],
    [FeedbackManager::class, 'dismiss', ['string'], 'bool'],
    [PendingFeedback::class, 'id', ['string'], PendingFeedback::class],
    [PendingFeedback::class, 'action', ['string', 'string'], PendingFeedback::class],
    [PendingFeedback::class, 'hold', [], PendingFeedback::class],
    [PendingFeedback::class, 'send', [], 'string'],
    [FeedbackCenterComponent::class, 'action', ['string', 'string'], 'void'],
    [FeedbackCenterComponent::class, 'dismiss', ['string', 'string'], 'void'],
] as [$class, $method, $parameterTypes, $returnType]) {
    $methodContract($class, $method, $parameterTypes, $returnType);
}

if (! is_subclass_of(Feedback::class, Facade::class)) {
    $errors[] = 'FirstlightUI\\Facades\\Feedback must extend the Laravel Facade';
} else {
    try {
        $reflection = new ReflectionClass(Feedback::class);
        $accessor = $reflection->getMethod('getFacadeAccessor');
        $instance = $reflection->newInstanceWithoutConstructor();
        if ($accessor->invoke($instance) !== FeedbackManager::class) {
            $errors[] = 'Feedback facade accessor must resolve FeedbackManager';
        }
    } catch (Throwable $exception) {
        $errors[] = 'Unable to verify Feedback facade accessor: '.$exception->getMessage();
    }
}

foreach ([
    FeedbackActionPressed::class => ['id' => 'string', 'actionKey' => 'string'],
    FeedbackDismissed::class => ['id' => 'string', 'reason' => FeedbackDismissReason::class],
] as $eventClass => $properties) {
    $event = new ReflectionClass($eventClass);
    if (! $event->isFinal() || ! $event->isReadOnly()) {
        $errors[] = "Application event must be final readonly: {$eventClass}";
    }
    foreach ($properties as $property => $type) {
        if (! $event->hasProperty($property)) {
            $errors[] = "Missing event payload: {$eventClass}::\${$property}";
        } else {
            $payload = $event->getProperty($property);
            if (! $payload->isPublic() || (string) $payload->getType() !== $type) {
                $errors[] = "Unexpected event payload contract: {$eventClass}::\${$property}";
            }
        }
    }
}

if (array_map(static fn (FeedbackTone $tone): string => $tone->value, FeedbackTone::cases()) !== [
    'default', 'success', 'warning', 'danger',
]) {
    $errors[] = 'FeedbackTone must contain exactly default, success, warning, and danger';
}

if (array_map(static fn (FeedbackDismissReason $reason): string => $reason->value, FeedbackDismissReason::cases()) !== [
    'timeout', 'manual', 'action',
]) {
    $errors[] = 'FeedbackDismissReason must contain exactly timeout, manual, and action';
}

try {
    $store = new FeedbackStore;
    $manager = new FeedbackManager($store);
    $manager->message('First')->id('first')->send();
    $manager->message('Second')->id('second')->send();
    $manager->warning('Updated')->id('first')->action('Retry', 'retry')->hold()->send();

    if (array_map(static fn (FeedbackRecord $record): string => $record->id, $store->all()) !== ['first', 'second']) {
        $errors[] = 'FeedbackStore must preserve FIFO position when updating a stable ID';
    }
    if ($store->all()[0]->tone !== FeedbackTone::Warning || ! $store->all()[0]->hold) {
        $errors[] = 'PendingFeedback modifiers must publish the updated semantic record';
    }

    $callbacks = new CallbackRegistry;
    $automatic = FeedbackItem::fromRecord(new FeedbackRecord(
        'automatic', 'Saved', FeedbackTone::Success, false, 'Undo', 'undo',
    ));
    $held = FeedbackItem::fromRecord(new FeedbackRecord(
        'held', 'Offline', FeedbackTone::Warning, true, null, null,
    ));
    $tree = FeedbackCenterElement::make($automatic, $held)->toArray($callbacks);
    $automaticProps = $tree['children'][0]['props'] ?? [];
    $heldProps = $tree['children'][1]['props'] ?? [];

    if (($tree['type'] ?? null) !== 'firstlight.feedback-center'
        || ($tree['children'][0]['type'] ?? null) !== 'firstlight.feedback-item'
        || ($tree['children'][1]['type'] ?? null) !== 'firstlight.feedback-item') {
        $errors[] = 'FeedbackCenter must publish nested center and item wire types';
    }
    foreach (['feedback_id', 'message', 'tone', 'hold', 'action_label', 'on_action', 'on_timeout', 'on_manual'] as $prop) {
        if (! array_key_exists($prop, $automaticProps)) {
            $errors[] = "Automatic feedback wire is missing: {$prop}";
        }
    }
    if (! array_key_exists('on_manual', $heldProps) || array_key_exists('on_timeout', $heldProps)) {
        $errors[] = 'Held feedback must publish manual but not timeout callback ownership';
    }
    if (array_intersect_key($tree, ['layout' => true, 'style' => true]) !== []
        || array_intersect_key($tree['children'][0] ?? [], ['layout' => true, 'style' => true]) !== []) {
        $errors[] = 'Feedback center and item wire nodes must not publish in-tree layout or style';
    }
} catch (Throwable $exception) {
    $errors[] = 'Unable to execute the PHP feedback and wire contract: '.$exception->getMessage();
}

$phpLifecyclePassed = false;
$previousContainer = Container::getInstance();

try {
    $container = new Container;
    Container::setInstance($container);
    $dispatcher = new Dispatcher($container);
    $store = new FeedbackStore;
    $manager = new FeedbackManager($store);
    $container->instance('events', $dispatcher);
    $container->instance(DispatcherContract::class, $dispatcher);
    $container->instance(FeedbackStore::class, $store);
    $container->instance(FeedbackManager::class, $manager);

    $component = new FeedbackCenterComponent;
    $observed = [];
    $removedBeforeAction = false;
    $dispatcher->listen(FeedbackActionPressed::class, static function (FeedbackActionPressed $event) use ($store, &$observed, &$removedBeforeAction): void {
        $removedBeforeAction = $store->all() === [];
        $observed[] = ['action', $event->id, $event->actionKey];
    });
    $dispatcher->listen(FeedbackDismissed::class, static function (FeedbackDismissed $event) use (&$observed): void {
        $observed[] = ['dismissed', $event->id, $event->reason->value];
    });

    $invokeWire = static function (FeedbackCenterComponent $component, CallbackRegistry $callbacks, int $callbackId): void {
        $callback = $callbacks->resolve($callbackId);
        if (! is_array($callback) || ! is_string($callback['method'] ?? null) || ! is_array($callback['args'] ?? null)) {
            throw new RuntimeException("Unable to resolve callback ID {$callbackId}");
        }

        $component->{$callback['method']}(...$callback['args']);
    };

    $manager->success('Saved')->id('saved')->action('Undo', 'undo')->send();
    $callbacks = new CallbackRegistry;
    $props = FeedbackItem::fromRecord($store->all()[0])->toArray($callbacks)['props'];
    $invokeWire($component, $callbacks, $props['on_action']);
    $invokeWire($component, $callbacks, $props['on_action']);

    if (! $removedBeforeAction || $observed !== [
        ['action', 'saved', 'undo'],
        ['dismissed', 'saved', 'action'],
    ]) {
        $errors[] = 'Action callback must remove first and dispatch action then dismissal exactly once';
    }

    $manager->message('Automatic')->id('automatic')->send();
    $callbacks = new CallbackRegistry;
    $props = FeedbackItem::fromRecord($store->all()[0])->toArray($callbacks)['props'];
    $invokeWire($component, $callbacks, $props['on_timeout']);

    $manager->warning('Held')->id('held')->hold()->send();
    $callbacks = new CallbackRegistry;
    $props = FeedbackItem::fromRecord($store->all()[0])->toArray($callbacks)['props'];
    $invokeWire($component, $callbacks, $props['on_manual']);

    $manager->message('Malformed')->id('malformed')->send();
    $component->dismiss('malformed', 'unsupported');
    $component->dismiss('malformed', FeedbackDismissReason::Action->value);
    if (array_map(static fn (FeedbackRecord $record): string => $record->id, $store->all()) !== ['malformed']) {
        $errors[] = 'Malformed and action dismiss reasons must be inert';
    }
    $manager->dismiss('malformed');

    $manager->message('Wrong action')->id('wrong-action')->action('Retry', 'retry')->send();
    $component->action('wrong-action', 'wrong-key');
    if ($store->all() !== []) {
        $errors[] = 'A mismatched action key must remove the addressed record';
    }

    if ($observed !== [
        ['action', 'saved', 'undo'],
        ['dismissed', 'saved', 'action'],
        ['dismissed', 'automatic', 'timeout'],
        ['dismissed', 'held', 'manual'],
    ]) {
        $errors[] = 'Timeout, manual, malformed, and programmatic event semantics are incorrect';
    }

    $throwingContainer = new Container;
    Container::setInstance($throwingContainer);
    $throwingDispatcher = new Dispatcher($throwingContainer);
    $throwingStore = new FeedbackStore;
    $throwingManager = new FeedbackManager($throwingStore);
    $throwingContainer->instance('events', $throwingDispatcher);
    $throwingContainer->instance(DispatcherContract::class, $throwingDispatcher);
    $throwingContainer->instance(FeedbackStore::class, $throwingStore);
    $throwingContainer->instance(FeedbackManager::class, $throwingManager);
    $throwingDismissals = [];
    $throwingDispatcher->listen(FeedbackActionPressed::class, static function (): never {
        throw new RuntimeException('lifecycle probe listener failed');
    });
    $throwingDispatcher->listen(FeedbackDismissed::class, static function (FeedbackDismissed $event) use (&$throwingDismissals): void {
        $throwingDismissals[] = [$event->id, $event->reason->value];
    });
    $throwingManager->message('Retry')->id('throwing')->action('Retry', 'retry')->send();

    try {
        (new FeedbackCenterComponent)->action('throwing', 'retry');
        $errors[] = 'Action listener exceptions must propagate';
    } catch (RuntimeException $exception) {
        if ($exception->getMessage() !== 'lifecycle probe listener failed') {
            throw $exception;
        }
    }

    if ($throwingStore->all() !== [] || $throwingDismissals !== [['throwing', 'action']]) {
        $errors[] = 'Action dismissal must dispatch from finally when an action listener throws';
    }

    $phpLifecyclePassed = true;
} catch (Throwable $exception) {
    $errors[] = 'Unable to execute PHP callback lifecycle checks: '.$exception->getMessage();
} finally {
    Container::setInstance($previousContainer);
}

$requireMarkers('src/FirstlightServiceProvider.php', [
    '$this->app->singleton(FeedbackStore::class)',
    '$this->app->singleton(FeedbackManager::class)',
    "ComponentRegistry::register('firstlight-feedback-center', FeedbackCenter::class)",
    'ChromeContributorRegistry::register(',
    "view('firstlight::native.feedback-center')",
]);
$requireMarkers('resources/views/native/feedback-center.blade.php', [
    '<native:firstlight-feedback-center key="firstlight-feedback-center" />',
]);

foreach ([
    'resources/ios/FeedbackCenterState.swift' => ['struct FeedbackCenterQueueState', 'private var tombstones: Set<String>'],
    'resources/ios/FeedbackCenterControl.swift' => ['struct FirstlightFeedbackCenterControl', 'minimumActionTarget = CGSize(width: 44, height: 44)'],
    'resources/ios/FeedbackCenterHost.swift' => ['struct FirstlightFeedbackCenterHost<Content: View>', '@Environment(\\.scenePhase)', '@Environment(\\.accessibilityReduceMotion)'],
    'resources/ios/FirstlightUIInit.swift' => ['func registerFirstlightUI()', '"firstlight.feedback-center"', 'consumes: "firstlight_feedback_center"'],
    'resources/android/FeedbackCenterState.kt' => ['class FeedbackCenterQueueState', 'private val tombstones = mutableSetOf<String>()'],
    'resources/android/FeedbackCenterControl.kt' => ['fun FirstlightFeedbackCenterControl(', 'minWidth = 48.dp, minHeight = 48.dp'],
    'resources/android/FeedbackCenterHost.kt' => ['fun FirstlightFeedbackCenterHost(', 'accessibilityManager::getRecommendedTimeoutMillis', 'Lifecycle.State.RESUMED'],
    'resources/android/FirstlightUIInit.kt' => ['fun registerFirstlightUI(context: Context)', '"firstlight.feedback-center"', 'consumes = "firstlight_feedback_center"'],
    'tests/ios/FeedbackCenterTests.swift' => [
        'final class FeedbackCenterTests: XCTestCase',
        'testCompletionTombstoneBlocksStaleFramesUntilAbsence',
        'testBackgroundPauseAndResumeExcludeSuspendedTime',
        'testStaleTimeoutCannotCompleteOrChargeTheNextItem',
        'testProgrammaticAbsenceAdvancesWithoutEmittingAnEvent',
    ],
    'tests/ios/FeedbackCenterSnapshotTests.swift' => [
        'final class FeedbackCenterSnapshotTests: XCTestCase',
        'testOneTimeAnnouncementAndReducedMotionPoliciesAreDeterministic',
    ],
    'tests/android/src/test/kotlin/dev/firstlightui/plugins/firstlight_ui/ui/FeedbackCenterTest.kt' => [
        'class FeedbackCenterQueueTest',
        'class FeedbackCenterSemanticsTest',
        'class FeedbackCenterInitContractTest',
        'class FeedbackCenterAndroidApi29Test',
        'completion tombstone blocks stale frames until an absence epoch',
        'pause resume excludes suspended time and repeated calls are safe',
        'stale timeout cannot complete or charge the next item',
        'production host owns exactly one id keyed live region',
        'host dismiss semantics enumerate and route automatic actionable held and empty states',
        'production lifecycle below resumed pauses and resumed excludes background time',
    ],
] as $path => $markers) {
    $requireMarkers($path, $markers);
}

$manifest = $json('nativephp.json');
if (is_array($manifest)) {
    if (($manifest['ios']['init_function'] ?? null) !== 'registerFirstlightUI') {
        $errors[] = 'nativephp.json iOS init_function must be registerFirstlightUI';
    }
    if (($manifest['android']['init_function'] ?? null) !== 'dev.firstlightui.plugins.firstlight_ui.registerFirstlightUI') {
        $errors[] = 'nativephp.json Android init_function must be dev.firstlightui.plugins.firstlight_ui.registerFirstlightUI';
    }
    foreach (['ios', 'android'] as $platform) {
        if (array_key_exists('bridge_functions', $manifest[$platform] ?? [])) {
            $errors[] = "nativephp.json {$platform} must not declare bridge_functions";
        }
    }
    foreach ($manifest['components'] ?? [] as $component) {
        if (($component['type'] ?? null) === 'firstlight.feedback-center') {
            $errors[] = 'Feedback Center is package chrome and must not be a consumer manifest component';
        }
    }
}

$featureSources = array_values(array_unique(array_merge(
    glob($root.'/src/Feedback/*.php') ?: [],
    glob($root.'/src/Events/Feedback*.php') ?: [],
    [
        $root.'/src/Facades/Feedback.php',
        $root.'/src/Elements/FeedbackCenter.php',
        $root.'/src/Elements/FeedbackItem.php',
        $root.'/src/NativeComponents/FeedbackCenter.php',
        $root.'/src/Support/CallbackExpression.php',
        $root.'/src/FirstlightServiceProvider.php',
        $root.'/resources/views/native/feedback-center.blade.php',
        $root.'/resources/ios/FeedbackCenterState.swift',
        $root.'/resources/ios/FeedbackCenterControl.swift',
        $root.'/resources/ios/FeedbackCenterHost.swift',
        $root.'/resources/ios/FirstlightUIInit.swift',
        $root.'/resources/android/FeedbackCenterState.kt',
        $root.'/resources/android/FeedbackCenterControl.kt',
        $root.'/resources/android/FeedbackCenterHost.kt',
        $root.'/resources/android/FirstlightUIInit.kt',
    ],
)));

foreach ($featureSources as $path) {
    if (! is_file($path)) {
        continue;
    }
    $contents = (string) file_get_contents($path);
    $relative = substr($path, strlen($root) + 1);
    if (preg_match('/Dialog\s*::\s*toast/i', $contents) === 1) {
        $errors[] = "Prohibited Dialog::toast call in feature source: {$relative}";
    }
    if (preg_match('/nativephp_call/i', $contents) === 1) {
        $errors[] = "Prohibited nativephp_call bridge in feature source: {$relative}";
    }
}

$public = $read('docs/components/transient-feedback.md');
$spec = $read('spec/components/transient-feedback.md');
$docsIndex = $read('docs/index.md');
$specIndex = $read('spec/index.md');

foreach ([
    'FirstlightUI\\Facades\\Feedback',
    'FeedbackActionPressed',
    'FeedbackDismissed',
    'There is no Blade tag and no host installation step',
] as $marker) {
    if (! str_contains($public, $marker)) {
        $errors[] = "Public guide is missing contract marker: {$marker}";
    }
}
if (str_contains($public, '<firstlight:transient-feedback')) {
    $errors[] = 'Public guide must not document a Transient Feedback Blade tag';
}
foreach (['firstlight.feedback-center', 'firstlight.feedback-item', '`on_action`', '`on_timeout`', '`on_manual`'] as $marker) {
    if (! str_contains($spec, $marker)) {
        $errors[] = "Maintained specification is missing wire marker: {$marker}";
    }
}
if (! str_contains($docsIndex, '(components/transient-feedback.md)')) {
    $errors[] = 'docs/index.md does not index Transient Feedback';
}
if (! str_contains($specIndex, '(components/transient-feedback.md)')) {
    $errors[] = 'spec/index.md does not index Transient Feedback';
}

$screenshots = $json('spec/screenshots.json');
$expectedScreenshotEntry = [
    'route' => '/captures/transient-feedback',
    'test' => 'php artisan test tests/Feature/TransientFeedbackCaptureTest.php',
    'outputs' => [
        'ios-light' => 'docs/screenshots/transient-feedback/ios-light.png',
        'ios-dark' => 'docs/screenshots/transient-feedback/ios-dark.png',
        'android-light' => 'docs/screenshots/transient-feedback/android-light.png',
        'android-dark' => 'docs/screenshots/transient-feedback/android-dark.png',
    ],
];
if (($screenshots['components']['transient-feedback'] ?? null) !== $expectedScreenshotEntry) {
    $errors[] = 'spec/screenshots.json must contain the exact Transient Feedback capture contract';
}

try {
    require_once $root.'/bin/support/DocumentationPage.php';
    require_once $root.'/bin/support/DocumentationRepository.php';
    require_once $root.'/bin/support/DocumentationArtifactBuilder.php';
    $outputs = (new DocumentationArtifactBuilder(new DocumentationRepository($root)))->outputs();
    foreach ($outputs as $path => $expected) {
        if (! is_file($root.'/'.$path)) {
            $errors[] = "Missing generated documentation artefact: {$path}";
        } elseif ((string) file_get_contents($root.'/'.$path) !== $expected) {
            $errors[] = "Generated documentation artefact is stale: {$path}";
        }
    }
} catch (Throwable $exception) {
    $errors[] = 'Unable to verify generated documentation artefacts: '.$exception->getMessage();
}

$git = static function (string $repository, array $arguments): Process {
    $process = new Process(['git', '-C', $repository, ...$arguments]);
    $process->setTimeout(15);
    $process->run();

    return $process;
};

$repositoryState = static function (string $label, string $path) use ($git, $evidenceIssue): ?array {
    $topLevel = $git($path, ['rev-parse', '--show-toplevel']);
    if (! $topLevel->isSuccessful()
        || realpath(trim($topLevel->getOutput())) !== realpath($path)) {
        $evidenceIssue("{$label} root is not a Git worktree");

        return null;
    }

    $head = $git($path, ['rev-parse', 'HEAD']);
    if (! $head->isSuccessful() || preg_match('/^[0-9a-f]{40}$/', trim($head->getOutput())) !== 1) {
        $evidenceIssue("Unable to resolve {$label} HEAD");

        return null;
    }

    $status = $git($path, ['status', '--porcelain=v1', '--untracked-files=all']);
    if (! $status->isSuccessful()) {
        $evidenceIssue("Unable to inspect {$label} release tree");
    } elseif (trim($status->getOutput()) !== '') {
        $evidenceIssue("{$label} release tree is dirty");
    }

    return ['head' => trim($head->getOutput())];
};

$packageRepository = $repositoryState('Package', $root);
$showcaseRepository = null;
$showcaseArtifactsComplete = true;

if (! is_dir($showcase)) {
    $evidenceIssue("Missing showcase root: {$showcase}");
    $showcaseArtifactsComplete = false;
} else {
    $showcaseRepository = $repositoryState('Showcase', $showcase);

    $showcaseArtifacts = [
        'app/NativeComponents/Captures/TransientFeedbackCapture.php' => 'Missing showcase capture component: app/NativeComponents/Captures/TransientFeedbackCapture.php',
        'resources/views/native/captures/transient-feedback.blade.php' => 'Missing showcase capture view: resources/views/native/captures/transient-feedback.blade.php',
        'tests/Feature/TransientFeedbackCaptureTest.php' => 'Missing focused showcase capture test: tests/Feature/TransientFeedbackCaptureTest.php',
        'routes/native.php' => 'Missing canonical showcase routes file: routes/native.php',
    ];
    foreach ($showcaseArtifacts as $path => $message) {
        if (! is_file($showcase.'/'.$path)) {
            $evidenceIssue($message);
            $showcaseArtifactsComplete = false;
        }
    }

    $routeContents = is_file($showcase.'/routes/native.php')
        ? (string) file_get_contents($showcase.'/routes/native.php')
        : '';
    if (preg_match(
        "/Route::native\(\s*['\"]\/captures\/transient-feedback['\"]\s*,\s*TransientFeedbackCapture::class\s*\)/",
        $routeContents,
    ) !== 1) {
        $evidenceIssue('Missing exact showcase capture route: /captures/transient-feedback');
        $showcaseArtifactsComplete = false;
    }

    $captureComponentExists = is_file($showcase.'/app/NativeComponents/Captures/TransientFeedbackCapture.php');
    $captureComponent = $captureComponentExists
        ? (string) file_get_contents($showcase.'/app/NativeComponents/Captures/TransientFeedbackCapture.php')
        : '';
    if ($captureComponentExists) {
        foreach ([
            'final class TransientFeedbackCapture extends NativeComponent',
            "Feedback::success('Appointment saved')",
            "->id('transient-feedback-capture')",
            "->action('Undo', 'undo-save')",
            '->hold()',
            "view('native.captures.transient-feedback')",
        ] as $marker) {
            if (! str_contains($captureComponent, $marker)) {
                $evidenceIssue("Showcase capture component is missing deterministic contract marker: {$marker}");
                $showcaseArtifactsComplete = false;
            }
        }
    }

    if (! $development && $showcaseArtifactsComplete && $showcaseRepository !== null) {
        $focusedTest = new Process(['php', 'artisan', 'test', 'tests/Feature/TransientFeedbackCaptureTest.php'], $showcase);
        $focusedTest->setTimeout(120);
        try {
            $focusedTest->run();
            if (! $focusedTest->isSuccessful()) {
                $testOutput = trim($focusedTest->getOutput()."\n".$focusedTest->getErrorOutput());
                $testOutput = preg_replace('/\s+/', ' ', $testOutput) ?? '';
                $testOutput = substr($testOutput, 0, 4000);
                $evidenceIssue("Focused showcase test failed with exit code {$focusedTest->getExitCode()}: {$testOutput}");
            }
        } catch (Throwable $exception) {
            $evidenceIssue('Unable to execute focused showcase test safely: '.$exception->getMessage());
        }
    }
}

$pngError = static function (string $path): ?string {
    if (! is_file($path)) {
        return 'file is missing';
    }

    $contents = file_get_contents($path);
    if (! is_string($contents) || substr($contents, 0, 8) !== "\x89PNG\r\n\x1a\n") {
        return 'invalid PNG signature';
    }

    $size = strlen($contents);
    $offset = 8;
    $chunkIndex = 0;
    $ihdr = null;
    $idat = '';
    $seenIdat = false;
    $idatEnded = false;
    $seenIend = false;

    while ($offset < $size) {
        if ($size - $offset < 12) {
            return 'truncated PNG chunk';
        }

        $length = unpack('Nlength', substr($contents, $offset, 4))['length'];
        if ($length > 64 * 1024 * 1024 || $length > $size - $offset - 12) {
            return 'PNG chunk exceeds file bounds';
        }

        $type = substr($contents, $offset + 4, 4);
        if (preg_match('/^[A-Za-z]{4}$/', $type) !== 1) {
            return 'invalid PNG chunk type';
        }
        $data = substr($contents, $offset + 8, $length);
        $crc = substr($contents, $offset + 8 + $length, 4);
        if (! hash_equals(pack('N', crc32($type.$data)), $crc)) {
            return "CRC mismatch for {$type}";
        }

        $offset += 12 + $length;
        $chunkIndex++;

        if ($chunkIndex === 1 && $type !== 'IHDR') {
            return 'IHDR is not the first chunk';
        }
        if ($type === 'IHDR') {
            if ($ihdr !== null || $length !== 13) {
                return 'IHDR must occur once with length 13';
            }
            $ihdr = unpack(
                'Nwidth/Nheight/CbitDepth/CcolorType/Ccompression/Cfilter/Cinterlace',
                $data,
            );
        } elseif ($type === 'IDAT') {
            if ($ihdr === null || $idatEnded) {
                return 'IDAT chunks must be consecutive after IHDR';
            }
            $seenIdat = true;
            $idat .= $data;
            if (strlen($idat) > 64 * 1024 * 1024) {
                return 'combined IDAT payload is too large';
            }
        } elseif ($type === 'IEND') {
            if ($length !== 0) {
                return 'IEND must be empty';
            }
            $seenIend = true;
            if ($offset !== $size) {
                return 'trailing bytes after IEND';
            }
            break;
        } else {
            if ($seenIdat) {
                $idatEnded = true;
            }
            if (ctype_upper($type[0]) && ! in_array($type, ['PLTE'], true)) {
                return "unsupported critical PNG chunk: {$type}";
            }
        }
    }

    if ($ihdr === null) {
        return 'missing IHDR';
    }
    if (! $seenIdat || $idat === '') {
        return 'missing non-empty IDAT';
    }
    if (! $seenIend) {
        return 'missing IEND at EOF';
    }

    $width = $ihdr['width'];
    $height = $ihdr['height'];
    if ($width < 320 || $height < 568 || $width > 4096 || $height > 8192
        || $width >= $height || $width * $height > 20_000_000) {
        return 'dimensions are not a meaningful phone viewport';
    }
    if ($ihdr['compression'] !== 0 || $ihdr['filter'] !== 0 || $ihdr['interlace'] !== 0) {
        return 'unsupported PNG compression filter or interlace method';
    }

    $channels = [0 => 1, 2 => 3, 3 => 1, 4 => 2, 6 => 4][$ihdr['colorType']] ?? null;
    $validDepths = [
        0 => [1, 2, 4, 8, 16],
        2 => [8, 16],
        3 => [1, 2, 4, 8],
        4 => [8, 16],
        6 => [8, 16],
    ];
    if ($channels === null || ! in_array($ihdr['bitDepth'], $validDepths[$ihdr['colorType']], true)) {
        return 'invalid PNG color type and bit depth';
    }

    $scanlineBytes = (int) ceil($width * $channels * $ihdr['bitDepth'] / 8);
    $expectedDecodedBytes = ($scanlineBytes + 1) * $height;
    if (! function_exists('gzuncompress')) {
        return 'PHP zlib support is unavailable';
    }
    $decoded = @gzuncompress($idat, $expectedDecodedBytes + 1);
    if (! is_string($decoded)) {
        return 'IDAT zlib decode failed';
    }
    if (strlen($decoded) !== $expectedDecodedBytes || strlen($idat) < 128) {
        return 'decoded scanline data is truncated or trivial';
    }
    for ($row = 0; $row < $height; $row++) {
        if (ord($decoded[$row * ($scanlineBytes + 1)]) > 4) {
            return 'invalid PNG scanline filter';
        }
    }

    return null;
};

foreach ($expectedScreenshotEntry['outputs'] as $path) {
    if (! is_file($root.'/'.$path)) {
        $evidenceIssue("Missing screenshot evidence: {$path}");
    } elseif (($reason = $pngError($root.'/'.$path)) !== null) {
        $evidenceIssue("Invalid screenshot PNG: {$path} ({$reason})");
    }
}

foreach ([['ios-light', 'ios-dark'], ['android-light', 'android-dark']] as [$light, $dark]) {
    $lightPath = $expectedScreenshotEntry['outputs'][$light];
    $darkPath = $expectedScreenshotEntry['outputs'][$dark];
    if ($pngError($root.'/'.$lightPath) === null && $pngError($root.'/'.$darkPath) === null
        && hash_file('sha256', $root.'/'.$lightPath) === hash_file('sha256', $root.'/'.$darkPath)) {
        $evidenceIssue("Screenshot variants must contain distinct evidence: {$light} and {$dark}");
    }
}

$reviewPath = 'spec/reviews/transient-feedback-alpha.md';
$review = '';
if (! is_file($root.'/'.$reviewPath)) {
    $evidenceIssue("Missing release review: {$reviewPath}");
} else {
    $review = (string) file_get_contents($root.'/'.$reviewPath);
}

$reviewPage = null;
if ($review !== '') {
    try {
        $reviewPage = FirstlightUI\Documentation\DocumentationPage::fromFile($root, $reviewPath);
    } catch (Throwable $exception) {
        $evidenceIssue('Release review frontmatter is invalid: '.$exception->getMessage());
    }
}
if ($reviewPage?->title !== 'Transient Feedback alpha review evidence') {
    $evidenceIssue('Release review must use the Transient Feedback alpha review evidence title');
}
if ($reviewPage?->status !== 'current') {
    $evidenceIssue('Release review must declare status: current');
}
if ($reviewPage?->audience !== 'maintainer') {
    $evidenceIssue('Release review must declare audience: maintainer');
}

$rows = [];
foreach (preg_split('/\R/', $review) ?: [] as $line) {
    $line = trim($line);
    if (! str_starts_with($line, '|') || ! str_ends_with($line, '|')) {
        continue;
    }

    $cells = array_map('trim', explode('|', trim($line, '|')));
    if ($cells !== [] && preg_match('/^-+$/', str_replace(' ', '', $cells[0])) !== 1) {
        $rows[$cells[0]][] = $cells;
    }
}

$row = static function (string $label, string $kind) use ($rows, $evidenceIssue): ?array {
    $matches = $rows[$label] ?? [];
    if ($matches === []) {
        $evidenceIssue("Release review is missing required {$kind}: {$label}");

        return null;
    }
    if (count($matches) > 1) {
        $evidenceIssue("Duplicate release review {$kind}: {$label}");

        return null;
    }

    return $matches[0];
};
$value = static fn (?string $value): string => trim((string) $value, " \t\n\r\0\x0B`");
$substantive = static function (string $value, int $minimum): bool {
    $value = trim($value);

    return strlen($value) >= $minimum
        && preg_match('/^(?:x|n\/?a|none|tbd|unknown|placeholder)$/i', $value) !== 1;
};

$componentRow = $row('Component', 'identity');
if ($componentRow !== null && ($componentRow[1] ?? null) !== 'Transient Feedback') {
    $evidenceIssue('Release review component identity must be Transient Feedback');
}
$modeRow = $row('Capture mode', 'identity');
if ($modeRow !== null && ($modeRow[1] ?? null) !== 'release') {
    $evidenceIssue('Release review capture mode must be release');
}
$dateRow = $row('Review date', 'identity');
$reviewDate = $value($dateRow[1] ?? null);
$parsedDate = DateTimeImmutable::createFromFormat('!Y-m-d', $reviewDate);
if ($dateRow !== null && ($parsedDate === false || $parsedDate->format('Y-m-d') !== $reviewDate)) {
    $evidenceIssue('Release review date must use YYYY-MM-DD');
}
$identityValues = [];
foreach (['Reviewer' => 8, 'iOS release target' => 24, 'Android release target' => 24] as $field => $minimum) {
    $identityRow = $row($field, 'identity');
    if ($identityRow !== null) {
        $identityValues[$field] = $value($identityRow[1] ?? null);
        if (! $substantive($identityValues[$field], $minimum)) {
            $evidenceIssue("Release review field must be substantive: {$field}");
        }
    }
}

$packageRevisionRow = $row('Reviewed package revision', 'identity');
$reviewedPackageRevision = $value($packageRevisionRow[1] ?? null);
if ($packageRevisionRow !== null && preg_match('/^[0-9a-f]{40}$/', $reviewedPackageRevision) !== 1) {
    $evidenceIssue('Reviewed package revision must be a 40-character Git commit');
}
$showcaseRevisionRow = $row('Showcase revision', 'identity');
$reviewedShowcaseRevision = $value($showcaseRevisionRow[1] ?? null);
if ($showcaseRevisionRow !== null && preg_match('/^[0-9a-f]{40}$/', $reviewedShowcaseRevision) !== 1) {
    $evidenceIssue('Showcase revision must be a 40-character Git commit');
}

if (preg_match('/^([0-9a-f])\1{39}$/', $reviewedPackageRevision) === 1) {
    $evidenceIssue('Reviewed package revision must not be a placeholder hash');
}
if (preg_match('/^([0-9a-f])\1{39}$/', $reviewedShowcaseRevision) === 1) {
    $evidenceIssue('Showcase revision must not be a placeholder hash');
}

if ($packageRepository !== null && preg_match('/^[0-9a-f]{40}$/', $reviewedPackageRevision) === 1
    && preg_match('/^([0-9a-f])\1{39}$/', $reviewedPackageRevision) !== 1) {
    $commit = $git($root, ['cat-file', '-e', $reviewedPackageRevision.'^{commit}']);
    if (! $commit->isSuccessful()) {
        $evidenceIssue('Reviewed package revision is not a package commit');
    } else {
        $ancestor = $git($root, ['merge-base', '--is-ancestor', $reviewedPackageRevision, 'HEAD']);
        if (! $ancestor->isSuccessful()) {
            $evidenceIssue('Reviewed package revision is not an ancestor of package HEAD');
        } else {
            $changed = $git($root, ['diff', '--name-only', $reviewedPackageRevision.'..HEAD', '--']);
            if (! $changed->isSuccessful()) {
                $evidenceIssue('Unable to audit paths changed after reviewed package revision');
            } else {
                $allowedEvidencePaths = [
                    'docs/screenshots/transient-feedback/ios-light.png',
                    'docs/screenshots/transient-feedback/ios-dark.png',
                    'docs/screenshots/transient-feedback/android-light.png',
                    'docs/screenshots/transient-feedback/android-dark.png',
                    'spec/reviews/transient-feedback-alpha.md',
                ];
                foreach (array_filter(explode("\n", trim($changed->getOutput()))) as $changedPath) {
                    if (! in_array($changedPath, $allowedEvidencePaths, true)) {
                        $evidenceIssue("Non-evidence path changed after reviewed package revision: {$changedPath}");
                    }
                }
            }
        }
    }
}
if ($showcaseRepository !== null && preg_match('/^[0-9a-f]{40}$/', $reviewedShowcaseRevision) === 1
    && $reviewedShowcaseRevision !== $showcaseRepository['head']) {
    $evidenceIssue('Showcase revision does not match clean showcase HEAD');
}

foreach ($expectedScreenshotEntry['outputs'] as $variant => $path) {
    $screenshotRows = $rows[$variant] ?? [];
    if (count($screenshotRows) > 1) {
        $evidenceIssue("Duplicate release review screenshot row: {$variant}");
        continue;
    }
    $screenshotRow = $screenshotRows[0] ?? null;
    if ($screenshotRow === null
        || $value($screenshotRow[1] ?? null) !== $path
        || ($screenshotRow[2] ?? null) !== 'PASS') {
        $evidenceIssue("Release review is missing exact PASS screenshot row: {$variant}");
        continue;
    }
    if (! $substantive($value($screenshotRow[3] ?? null), 24)) {
        $evidenceIssue("Release review screenshot detail must be substantive: {$variant}");
    }
}

$requiredEvidence = [
    'Focused showcase test',
    'Release screenshot capture',
    'iOS platform runtime',
    'Android platform runtime',
    'Navigation and background lifecycle',
    'VoiceOver',
    'TalkBack',
    'iOS physical device',
    'Android physical device',
    'Visual approval',
];
foreach ($requiredEvidence as $evidence) {
    $evidenceRows = $rows[$evidence] ?? [];
    if (count($evidenceRows) > 1) {
        $evidenceIssue("Duplicate release review evidence row: {$evidence}");
        continue;
    }
    $evidenceRow = $evidenceRows[0] ?? null;
    if ($evidenceRow === null) {
        $evidenceIssue("Release review is missing required evidence row: {$evidence}");
        continue;
    }
    $requiredResult = $evidence === 'Visual approval' ? 'APPROVED' : 'PASS';
    if (($evidenceRow[1] ?? null) !== $requiredResult) {
        $evidenceIssue("Release review evidence row must be {$requiredResult}: {$evidence}");
    }
    if (! $substantive($value($evidenceRow[2] ?? null), 24)) {
        $evidenceIssue("Release review evidence detail must be substantive: {$evidence}");
    }
    if ($evidence === 'Visual approval') {
        $approvalDetail = $value($evidenceRow[2] ?? null);
        if (($identityValues['Reviewer'] ?? '') !== '' && ! str_contains($approvalDetail, $identityValues['Reviewer'])) {
            $evidenceIssue('Visual approval detail must name the recorded reviewer');
        }
        if ($reviewDate !== '' && ! str_contains($approvalDetail, $reviewDate)) {
            $evidenceIssue('Visual approval detail must name the review date');
        }
    }
}

if (preg_match('/^\s*-\s*\[\s\]\s/m', $review) === 1) {
    $evidenceIssue("Release review has open checklist rows: {$reviewPath}");
}
foreach (['OPEN', 'PENDING', 'DEFERRED', 'NOT RUN', 'SKIP', 'SKIPPED', 'UNKNOWN', 'TODO', 'BLOCKED', 'FAIL', 'FAILED'] as $status) {
    $pattern = '/\b'.str_replace('\\ ', '\\s+', preg_quote($status, '/')).'\b/i';
    if (preg_match($pattern, $review) === 1) {
        $evidenceIssue("Release review contains prohibited unresolved status: {$status}");
    }
}

$errors = array_values(array_unique($errors));
$gaps = array_values(array_unique($gaps));

if ($errors !== []) {
    fwrite(STDERR, "Transient Feedback checks failed:\n");
    foreach ($errors as $error) {
        fwrite(STDERR, "- {$error}\n");
    }
    exit(1);
}

fwrite(STDOUT, "Transient Feedback structural checks passed.\n");
if ($phpLifecyclePassed) {
    fwrite(STDOUT, "PHP callback lifecycle checks passed.\n");
}
fwrite(STDOUT, "Native behavioral suites are structurally required but run separately.\n");
if ($gaps !== []) {
    fwrite(STDOUT, "Development evidence gaps (allowed):\n");
    foreach ($gaps as $gap) {
        fwrite(STDOUT, "- {$gap}\n");
    }
}
