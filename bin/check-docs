#!/usr/bin/env php
<?php

declare(strict_types=1);

use FirstlightUI\Documentation\DocumentationArtifactBuilder;
use FirstlightUI\Documentation\DocumentationRepository;
use FirstlightUI\Documentation\DocumentationValidator;

require_once __DIR__.'/support/DocumentationPage.php';
require_once __DIR__.'/support/DocumentationRepository.php';
require_once __DIR__.'/support/DocumentationArtifactBuilder.php';
require_once __DIR__.'/support/DocumentationValidator.php';

$arguments = array_slice($argv, 1);
if ($arguments !== [] && $arguments !== ['--development']) {
    fwrite(STDERR, "Usage: bin/check-docs [--development]\n");
    exit(2);
}

$root = dirname(__DIR__);
$repository = new DocumentationRepository($root);
$builder = new DocumentationArtifactBuilder($repository);
$validator = new DocumentationValidator($root, $repository, $builder);
$errors = $validator->errors($arguments === ['--development']);

if ($errors !== []) {
    fwrite(STDERR, "Documentation checks failed:\n");
    foreach ($errors as $error) {
        fwrite(STDERR, "- {$error}\n");
    }
    exit(1);
}

fwrite(STDOUT, "Documentation checks passed.\n");
