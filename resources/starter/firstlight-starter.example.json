{
    "description": "Field technicians see the day's jobs, add photos and notes to a job, and keep working without signal.",
    "app": {
        "name": "Fieldwork",
        "id": "com.acme.fieldwork",
        "deeplink_scheme": "fieldwork",
        "appearance": "system"
    },
    "theme": {
        "light": {"primary": "#0F766E", "on-primary": "#FFFFFF"},
        "dark": null
    },
    "icon": null,
    "locale": {"locale": "en", "fallback": "en", "timezone": "Australia/Sydney"},
    "android_min_sdk": 29,
    "layout": {
        "type": "tabs",
        "tabs": [
            {"label": "Jobs", "url": "/jobs", "icon": "list"},
            {"label": "Settings", "url": "/settings", "icon": "settings"}
        ]
    },
    "records": [
        {"model": "Job", "deletable": true, "delete_rule": "Only the technician assigned to the job"}
    ],
    "screens": [
        {"class": "JobsScreen", "route": "/jobs", "recipe": "how-to/build-a-searchable-list-screen"},
        {"class": "CreateJobScreen", "route": "/jobs/create", "recipe": "how-to/build-a-form-screen"},
        {"class": "JobScreen", "route": "/jobs/{job}", "recipe": "how-to/build-a-list-detail-flow"},
        {"class": "EditJobScreen", "route": "/jobs/{job}/edit", "recipe": "how-to/keep-drafts"},
        {"class": "JobPhotoScreen", "route": "/jobs/{job}/photo", "recipe": "how-to/build-a-photo-upload-screen"},
        {"class": "SettingsScreen", "route": "/settings", "recipe": "how-to/build-a-settings-screen"}
    ],
    "plugins": [
        {"package": "nativephp/mobile-network", "accepted": true},
        {"package": "nativephp/mobile-share", "accepted": true},
        {"package": "firstlightui/app-guard", "accepted": false},
        {"package": "nativephp/mobile-biometrics", "accepted": false}
    ],
    "permissions": {
        "NSCameraUsageDescription": "Fieldwork uses the camera to add photos to a job."
    }
}
