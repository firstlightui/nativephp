<?php

namespace App\NativeComponents\Layouts;

use FirstlightUI\NativeComponent as FirstlightScreen;
use Native\Mobile\Edge\Layouts\Builders\NavBar;
@starter(tabs)
use Native\Mobile\Edge\Layouts\Builders\Tab;
use Native\Mobile\Edge\Layouts\Builders\TabBar;
@endstarter
use Native\Mobile\Edge\Layouts\NativeLayout;
use Native\Mobile\Edge\NativeComponent;

class AppLayout extends NativeLayout
{
    public function usesNativeChrome(): bool
    {
        return true;
    }

    public function navBar(NativeComponent $screen): ?NavBar
    {
        $isRoot = $screen instanceof FirstlightScreen && $screen->isRootScreen();

        $bar = NavBar::make()
            ->title($screen->navTitle())
            ->displayMode($isRoot ? 'large' : 'inline')
            ->back(! $isRoot);

        // Screens list their own bar buttons, such as "New" on a list or "Edit" on a detail screen.
        foreach (method_exists($screen, 'navActions') ? $screen->navActions() : [] as $action) {
            $bar->action($action);
        }

        return $bar;
    }
@starter(tabs)

    public function tabBar(NativeComponent $screen): ?TabBar
    {
        if (! $screen instanceof FirstlightScreen || ! $screen->isRootScreen()) {
            return null;
        }

        return TabBar::make()
__tab_links__;
    }
@endstarter
}
